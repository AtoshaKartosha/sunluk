    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.15.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
