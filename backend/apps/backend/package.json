  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "lint": "tsc --noEmit",
    "start": "medusa exec ./src/scripts/update-luna-images.js && medusa start",
    "dev": "medusa develop",
    "test:integration:http": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --silent=false --runInBand --forceExit",
    "test:integration:modules": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --silent=false --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --silent --runInBand --forceExit",
    "test": "npm run test:unit",
    "seed": "medusa exec ./src/scripts/initial-data-seed.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.15.3",
    "@medusajs/admin-shared": "2.15.3",
