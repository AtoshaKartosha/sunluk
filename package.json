{
  "name": "sunluk",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev:storefront": "npm run dev --prefix storefront",
    "build:storefront": "npm run build --prefix storefront",
    "lint:storefront": "npm run lint --prefix storefront",
    "dev:backend": "npm run backend:dev --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "lint:backend": "npm run lint --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "backend:seed": "npm run backend:seed --prefix backend",
    "db:setup:local": "node scripts/local-postgres.js setup",
    "db:start:local": "node scripts/local-postgres.js start",
    "db:status:local": "node scripts/local-postgres.js status",
    "backend:prepare:local": "npm run db:setup:local && npm exec --prefix backend --workspace @dtc/backend -- medusa db:migrate",
    "dev:backend:local": "npm run backend:prepare:local && npm run dev:backend",
    "lint": "npm run lint:storefront && npm run lint:backend",
    "build": "npm run build:storefront && npm run build:backend",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  }
}
